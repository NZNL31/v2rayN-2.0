<UserControl
    x:Class="v2rayN.Desktop.Views.ProfilesView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:v2rayN.Desktop.Controls"
    xmlns:conv="using:v2rayN.Desktop.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:Name="Root"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vms:ProfilesViewModel"
    Design.DataContext="{x:Static dd:DesignData.Profiles}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <conv:DelayColorConverter x:Key="DelayColorConverter" />
    <conv:PositiveToBoolConverter x:Key="PositiveToBool" />
        <conv:RegionConverter x:Key="Region" />
        <conv:GroupHeaderConverter x:Key="IsGroupHeader" />

        <!--  左侧导航项：圆角胶囊 + 选中浅蓝底  -->
        <ControlTheme x:Key="NavItemTheme" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type DataGridColumnChooser}" TargetType="DataGridColumnChooser">
            <Setter Property="ItemTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="DataGridColumnChooserItem">
                        <CheckBox
                            Margin="0,2"
                            Content="{Binding Header}"
                            IsChecked="{Binding IsVisible, Mode=TwoWay}"
                            IsEnabled="{Binding CanUserHide}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Button Classes="IconButton Success" ToolTip.Tip="{TemplateBinding ToolTip.Tip}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <Border
                                        MaxWidth="260"
                                        MaxHeight="360"
                                        Padding="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter />
                                        </ScrollViewer>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        </Button>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </ControlTheme>
    </UserControl.Resources>

    <UserControl.Styles>
        <!--  当前节点：别名加粗  -->
        <Style Selector="TextBlock.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>
    <Grid>
            <!--  右侧内容区  -->
            <DockPanel Margin="0,10,18,14">
                <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto" DockPanel.Dock="Top">
                    <WrapPanel Grid.Column="0">
                    <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                        <TextBox
                            x:Name="txtServerFilter"
                            Width="200"
                            Padding="8,0,26,0"
                            VerticalContentAlignment="Center"
                            CornerRadius="7"
                            PlaceholderText="{x:Static resx:ResUI.TipSearchServer}"
                            ToolTip.Tip="{x:Static resx:ResUI.TipSearchServerHint}" />
                        <Button
                            x:Name="btnClearFilter"
                            Width="18"
                            Height="18"
                            Margin="0,0,6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Click="BtnClearFilter_Click"
                            IsVisible="False"
                            Theme="{DynamicResource HeaderIconButton}"
                            ToolTip.Tip="{x:Static resx:ResUI.TipClearFilter}">
                            <Path
                                Width="8"
                                Height="8"
                                Data="M0,0 L8,8 M8,0 L0,8"
                                Stretch="None"
                                Stroke="{DynamicResource AppTextSecondary}"
                                StrokeLineCap="Round"
                                StrokeThickness="1.3" />
                        </Button>
                    </Grid>

                    <Button
                        x:Name="btnAutofitColumnWidth"
                        Margin="{StaticResource MarginLr4}"
                        Classes="IconButton Success"
                        ToolTip.Tip="{x:Static resx:ResUI.menuProfileAutofitColumnWidth}">
                        <Button.Content>
                            <PathIcon Data="{StaticResource SemiIconExpand}" />
                        </Button.Content>
                    </Button>

                    <DataGridColumnChooser
                        Margin="{StaticResource MarginLr4}"
                        DataGrid="{Binding ElementName=lstProfiles}"
                        ToolTip.Tip="{x:Static resx:ResUI.menuColumns}">
                        <DataGridColumnChooser.Header>
                            <PathIcon Data="{StaticResource SemiIconSetting}" />
                        </DataGridColumnChooser.Header>
                    </DataGridColumnChooser>

                    <Button
                        x:Name="btnFastRealPing"
                        Margin="{StaticResource MarginLr4}"
                        Classes="IconButton Success"
                        ToolTip.Tip="{x:Static resx:ResUI.menuFastRealPing}">
                        <Button.Content>
                            <PathIcon Data="{StaticResource SemiIconBolt}" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="menuMixedTestServer"
                        Margin="{StaticResource MarginLr4}"
                        Classes="IconButton Success"
                        ToolTip.Tip="{x:Static resx:ResUI.menuMixedTestServer}">
                        <Button.Content>
                            <PathIcon Data="{StaticResource building_ping}" />
                        </Button.Content>
                    </Button>
                    <Button
                        x:Name="btnSubEditTop"
                        Margin="{StaticResource MarginLr4}"
                        Classes="IconButton Success"
                        ToolTip.Tip="{x:Static resx:ResUI.menuSubEdit}">
                        <Button.Content>
                            <PathIcon Data="{StaticResource SemiIconEdit}" />
                        </Button.Content>
                    </Button>
                    <!--  更新当前订阅：一次跑两遍（先直连，再走代理）  -->
                    <Button
                        x:Name="btnSubUpdateTop"
                        Margin="{StaticResource MarginLr4}"
                        Classes="IconButton Success"
                        Click="BtnSubUpdateTop_Click"
                        ToolTip.Tip="{x:Static resx:ResUI.TipUpdateSubDirectFirst}">
                        <Button.Content>
                            <Path
                                Width="17"
                                Height="17"
                                Data="M8.5,2.6 V10.4 M5.2,7.2 L8.5,10.5 L11.8,7.2 M3,13.4 H14"
                                Stretch="None"
                                Stroke="{DynamicResource AppTextPrimary}"
                                StrokeLineCap="Round"
                                StrokeJoin="Round"
                                StrokeThickness="1.5" />
                        </Button.Content>
                    </Button>
                    </WrapPanel>

                    <!--  当前视图汇总：节点数 · 已测 · 平均延迟  -->
                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0,4,0"
                        VerticalAlignment="Center"
                        FontSize="11.5"
                        Foreground="{DynamicResource AppTextSecondary}"
                        Text="{Binding GroupSummaryText}"
                        TextTrimming="CharacterEllipsis" />
                </Grid>

                <Border
                    Background="{DynamicResource AppCardBg}"
                    BorderBrush="{DynamicResource AppCardBorder}"
                    BorderThickness="1"
                    BoxShadow="0 1 3 0 #14000000"
                    ClipToBounds="True"
                    CornerRadius="16">
            <Grid>
            <DataGrid
                x:Name="lstProfiles"
                AutoGenerateColumns="False"
                BorderThickness="0"
                CanUserAddRows="False"
                CanUserDeleteRows="False"
                CanUserHideColumns="True"
                CanUserReorderColumns="True"
                CanUserResizeColumns="True"
                Classes.InsetContent="True"
                HorizontalScrollBarVisibility="Disabled"
                GridLinesVisibility="None"
                HeadersVisibility="All"
                IsReadOnly="False"
                ItemsSource="{Binding ProfileItems}"
                ShowRowNumbers="False">
                <DataGrid.KeyBindings>
                    <KeyBinding Command="{Binding Export2ShareUrlCmd}" Gesture="Ctrl+C" />
                    <KeyBinding Command="{Binding SetDefaultServerCmd}" Gesture="Enter" />
                </DataGrid.KeyBindings>
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem
                            x:Name="menuSetDefaultServer"
                            Header="{x:Static resx:ResUI.menuSetDefaultServer}"
                            InputGesture="Enter" />
                        <MenuItem
                            x:Name="menuEditServer"
                            Header="{x:Static resx:ResUI.menuEditServer}"
                            InputGesture="Ctrl+D" />
                        <MenuItem x:Name="menuCopyServer" Header="{x:Static resx:ResUI.menuCopyServer}" />
                        <MenuItem
                            x:Name="menuRemoveServer"
                            Header="{x:Static resx:ResUI.menuRemoveServer}"
                            InputGesture="Back" />
                        <MenuItem x:Name="menuRemoveDuplicateServer" Header="{x:Static resx:ResUI.menuRemoveDuplicateServer}" />
                        <MenuItem x:Name="menuRemoveInvalidServerResult" Header="{x:Static resx:ResUI.menuRemoveInvalidServerResult}" />
                        <Separator />
                        <MenuItem
                            x:Name="menuTcpingServer"
                            Header="{x:Static resx:ResUI.menuTcpingServer}"
                            InputGesture="Ctrl+O" />
                        <MenuItem
                            x:Name="menuRealPingServer"
                            Header="{x:Static resx:ResUI.menuRealPingServer}"
                            InputGesture="Ctrl+R" />
                        <MenuItem
                            x:Name="menuSpeedServer"
                            Header="{x:Static resx:ResUI.menuSpeedServer}"
                            InputGesture="Ctrl+T" />
                        <MenuItem x:Name="menuUdpTestServer" Header="{x:Static resx:ResUI.menuUdpTestServer}" />
                        <MenuItem x:Name="menuSortServerResult" Header="{x:Static resx:ResUI.menuSortServerResult}" />
                        <Separator />
                        <MenuItem
                            x:Name="menuMoveToGroup"
                            Header="{x:Static resx:ResUI.menuMoveToGroup}"
                            ItemsSource="{Binding DataContext.SubItems, ElementName=Root}">
                            <MenuItem.ItemTemplate>
                                <DataTemplate>
                                    <MenuItem
                                        Command="{Binding DataContext.MoveToGroupCmd, ElementName=Root}"
                                        CommandParameter="{Binding}"
                                        Header="{Binding Remarks}" />
                                </DataTemplate>
                            </MenuItem.ItemTemplate>
                        </MenuItem>
                        <MenuItem Header="{x:Static resx:ResUI.menuMoveTo}">
                            <MenuItem
                                x:Name="menuMoveTop"
                                Header="{x:Static resx:ResUI.menuMoveTop}"
                                InputGesture="T" />
                            <MenuItem
                                x:Name="menuMoveUp"
                                Header="{x:Static resx:ResUI.menuMoveUp}"
                                InputGesture="U" />
                            <MenuItem
                                x:Name="menuMoveDown"
                                Header="{x:Static resx:ResUI.menuMoveDown}"
                                InputGesture="D" />
                            <MenuItem
                                x:Name="menuMoveBottom"
                                Header="{x:Static resx:ResUI.menuMoveBottom}"
                                InputGesture="B" />
                        </MenuItem>
                        <MenuItem
                            x:Name="menuSelectAll"
                            Header="{x:Static resx:ResUI.menuSelectAll}"
                            InputGesture="Ctrl+A" />
                        <Separator />
                        <MenuItem
                            x:Name="menuShareServer"
                            Header="{x:Static resx:ResUI.menuShareServer}"
                            InputGesture="Ctrl+F" />
                        <MenuItem Header="{x:Static resx:ResUI.menuExportConfig}">
                            <MenuItem x:Name="menuExport2ClientConfig" Header="{x:Static resx:ResUI.menuExport2ClientConfig}" />
                            <MenuItem x:Name="menuExport2ClientConfigClipboard" Header="{x:Static resx:ResUI.menuExport2ClientConfigClipboard}" />
                            <Separator />
                            <MenuItem
                                x:Name="menuExport2ShareUrl"
                                Header="{x:Static resx:ResUI.menuExport2ShareUrl}"
                                InputGesture="Ctrl+C" />
                            <MenuItem x:Name="menuExport2ShareUrlBase64" Header="{x:Static resx:ResUI.menuExport2ShareUrlBase64}" />
                            <MenuItem x:Name="menuExport2InnerUri" Header="{x:Static resx:ResUI.menuExport2InnerUri}" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{x:Static resx:ResUI.menuGenGroupServer}">
                            <MenuItem x:Name="menuGenGroupAllServer" Header="{x:Static resx:ResUI.menuAllServers}" />
                            <MenuItem x:Name="menuGenGroupRegionServer" Header="{x:Static resx:ResUI.menuGenRegionGroup}" />
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>

                <DataGrid.Columns>
                    <!--  类型：居中显示；当前节点左侧带一条 2px 竖条强调  -->
                    <DataGridTemplateColumn
                        Width="80"
                        Header="{x:Static resx:ResUI.LvServiceType}"
                        SortMemberPath="ConfigType"
                        Tag="ConfigType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Border
                                        Width="2"
                                        Margin="3,8"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Stretch"
                                        Background="{DynamicResource AppTextPrimary}"
                                        CornerRadius="1"
                                        IsVisible="{Binding IsActive}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextAlignment="Center"
                                        Classes.headerEmpty="{Binding Converter={StaticResource IsGroupHeader}}"
                                        Text="{Binding ConfigType}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  别名：按比例伸缩（2*），窗口变宽变窄都跟着走  -->
                    <DataGridTemplateColumn
                        Width="2*"
                        MinWidth="140"
                        Header="{x:Static resx:ResUI.LvRemarks}"
                        SortMemberPath="Remarks"
                        Tag="Remarks">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  用 Grid 约束文本宽度，避免长别名把星号列撑开  -->
                                <Grid Margin="{StaticResource MarginLr8}" ColumnDefinitions="Auto,*">
                                    <StackPanel
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <Label
                                            Margin="{StaticResource MarginLr4}"
                                            Classes="Solid Red"
                                            Content="{x:Static resx:ResUI.TipActiveServer}"
                                            IsVisible="{Binding IsActive}"
                                            Theme="{DynamicResource TagLabel}" />
                                        <!--  地区徽章：从别名推断 HK / US / JP …  -->
                                        <Border Classes="RegionBadge" IsVisible="{Binding Remarks, Converter={StaticResource Region}, ConverterParameter=bool}">
                                            <TextBlock Text="{Binding Remarks, Converter={StaticResource Region}}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Classes.active="{Binding IsActive}"
                                        Classes.header="{Binding Converter={StaticResource IsGroupHeader}}"
                                        Text="{Binding Remarks}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  地址：按比例伸缩（3*），文本超长省略  -->
                    <DataGridTemplateColumn
                        Width="3*"
                        MinWidth="160"
                        Header="{x:Static resx:ResUI.LvAddress}"
                        SortMemberPath="Address"
                        Tag="Address">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="{StaticResource MarginLr8}"
                                    VerticalAlignment="Center"
                                    Classes.headerEmpty="{Binding Converter={StaticResource IsGroupHeader}}"
                                    Text="{Binding Address}"
                                    TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  端口：居中，和居中表头对齐  -->
                    <DataGridTemplateColumn
                        Width="90"
                        Header="{x:Static resx:ResUI.LvPort}"
                        SortMemberPath="Port"
                        Tag="Port">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    TextAlignment="Center"
                                    Classes.headerEmpty="{Binding Converter={StaticResource IsGroupHeader}}"
                                    Text="{Binding Port}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding Network}"
                        Header="{x:Static resx:ResUI.LvTransportProtocol}"
                        IsReadOnly="True"
                        Tag="Network" IsVisible="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding StreamSecurity}"
                        Header="{x:Static resx:ResUI.LvTLS}"
                        IsReadOnly="True"
                        Tag="StreamSecurity" IsVisible="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding SubRemarks}"
                        Header="{x:Static resx:ResUI.LvSubscription}"
                        IsReadOnly="True"
                        Tag="SubRemarks" />
                    <DataGridTemplateColumn
                        Width="110"
                        Header="{x:Static resx:ResUI.LvTestDelay}"
                        SortMemberPath="Delay"
                        Tag="DelayVal">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!--  延迟：4 段信号条（越慢段数越少）+ 数字，单色  -->
                                <StackPanel
                                    Margin="{StaticResource MarginLr8}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <controls:MiniBars
                                        Width="26"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource AppTextPrimary}"
                                        Invert="True"
                                        IsVisible="{Binding Delay, Converter={StaticResource PositiveToBool}}"
                                        Max="400"
                                        Segments="4"
                                        Value="{Binding Delay}" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource AppTextSecondary}"
                                        IsVisible="{Binding Delay, Converter={StaticResource PositiveToBool}}"
                                        Text="{Binding Path=DelayVal, Mode=OneWay}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!--  速度：进度条（按 100 Mbps 归一化）+ 数字，单色  -->
                    <DataGridTemplateColumn
                        Width="150"
                        Header="{x:Static resx:ResUI.LvTestSpeed}"
                        SortMemberPath="Speed"
                        Tag="SpeedVal">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="{StaticResource MarginLr8}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="6">
                                    <TextBlock
                                        MinWidth="46"
                                        VerticalAlignment="Center"
                                        TextAlignment="Right"
                                        Text="{Binding Path=SpeedVal, Mode=OneWay}" />
                                    <controls:MiniBars
                                        Width="52"
                                        Height="6"
                                        VerticalAlignment="Center"
                                        Fill="{DynamicResource AppTextPrimary}"
                                        IsVisible="{Binding Speed, Converter={StaticResource PositiveToBool}}"
                                        Max="100"
                                        Segments="1"
                                        Value="{Binding Speed}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!--  行内快捷操作：悬停时右侧浮出 编辑 / 测速 / 复制 / 删除  -->
                    <DataGridTemplateColumn
                        Width="104"
                        Tag="RowActions"
                        CanUserResize="False"
                        CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel
                                    Margin="0,0,4,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Spacing="1">
                                    <Button
                                        Classes="RowAction"
                                        Tag="edit"
                                        Click="RowAction_Click"
                                        Theme="{DynamicResource HeaderIconButton}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuEditServer}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource SemiIconEdit}" />
                                    </Button>
                                    <Button
                                        Classes="RowAction"
                                        Tag="ping"
                                        Click="RowAction_Click"
                                        Theme="{DynamicResource HeaderIconButton}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuRealPingServer}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource SemiIconBolt}" />
                                    </Button>
                                    <Button
                                        Classes="RowAction"
                                        Tag="copy"
                                        Click="RowAction_Click"
                                        Theme="{DynamicResource HeaderIconButton}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuCopyServer}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource building_copy}" />
                                    </Button>
                                    <Button
                                        Classes="RowAction"
                                        Tag="delete"
                                        Click="RowAction_Click"
                                        Theme="{DynamicResource HeaderIconButton}"
                                        ToolTip.Tip="{x:Static resx:ResUI.menuRemoveServer}">
                                        <PathIcon Width="13" Height="13" Data="{StaticResource building_delete}" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn
                        Header="{x:Static resx:ResUI.LvTestIpInfo}"
                        SortMemberPath="IpInfo"
                        Tag="IpInfo"
                        IsVisible="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Margin="{StaticResource MarginLr8}"
                                    VerticalAlignment="Center"
                                    Text="{Binding Path=IpInfo, Mode=OneWay}">
                                    <TextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="CopyIpInfo_Click"
                                                CommandParameter="{Binding IpInfo}"
                                                Header="{x:Static resx:ResUI.menuEditCopy}" />
                                        </ContextMenu>
                                    </TextBlock.ContextMenu>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding TodayUp}"
                        Header="{x:Static resx:ResUI.LvTodayUploadDataAmount}"
                        IsReadOnly="True"
                        Tag="TodayUp" IsVisible="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding TodayDown}"
                        Header="{x:Static resx:ResUI.LvTodayDownloadDataAmount}"
                        IsReadOnly="True"
                        Tag="TodayDown" IsVisible="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding TotalUp}"
                        Header="{x:Static resx:ResUI.LvTotalUploadDataAmount}"
                        IsReadOnly="True"
                        Tag="TotalUp" IsVisible="False" />
                    <DataGridTextColumn
                        Width="100"
                        Binding="{Binding TotalDown}"
                        Header="{x:Static resx:ResUI.LvTotalDownloadDataAmount}"
                        IsReadOnly="True"
                        Tag="TotalDown" IsVisible="False" />
                </DataGrid.Columns>
            </DataGrid>
                <TextBlock
                    x:Name="txtEmptyState"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    IsHitTestVisible="False"
                    IsVisible="False"
                    Text="{x:Static resx:ResUI.TipNoServer}" />
            </Grid>
                </Border>
            </DockPanel>
            </Grid>
</UserControl>

