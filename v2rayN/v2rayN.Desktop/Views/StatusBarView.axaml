<UserControl
    x:Class="v2rayN.Desktop.Views.StatusBarView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dd="clr-namespace:v2rayN.Desktop.DesignData"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:StatusBarViewModel"
    Design.DataContext="{x:Static dd:DesignData.StatusBar}"
    mc:Ignorable="d">
    <Grid>
        <!--  命令栏式状态条：左侧 Tun / 模式 / 路由 三个描边按钮，右侧当前节点两行信息  -->
        <DockPanel Margin="10,9">

            <!--  右：当前节点（名称 + 延迟/地区），两行右对齐  -->
            <StackPanel
                Margin="0,0,4,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right">
                <TextBlock
                    x:Name="txtRunningServerDisplay"
                    MaxWidth="180"
                    FontSize="12.5"
                    HorizontalAlignment="Right"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding RunningServerDisplay}" />
                <TextBlock
                    x:Name="txtRunningInfoDisplay"
                    MaxWidth="180"
                    FontSize="11.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    HorizontalAlignment="Right"
                    TextAlignment="Right"
                    TextTrimming="CharacterEllipsis"
                    ToolTip.Tip="{Binding RunningInfoDisplay}" />
            </StackPanel>

            <!--  右：测速结果（平时为空，不占宽度）  -->
            <StackPanel
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Right">
                <TextBlock
                    x:Name="txtSpeedProxyDisplay"
                    FontSize="11.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    HorizontalAlignment="Right" />
                <TextBlock
                    x:Name="txtSpeedDirectDisplay"
                    FontSize="11.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    HorizontalAlignment="Right" />
            </StackPanel>

            <!--  左：Tun 开关（描边胶囊）  -->
            <Border
                Classes="StatusPill"
                DockPanel.Dock="Left"
                Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Text="Tun" />
                    <ToggleSwitch
                        x:Name="togEnableTun"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Theme="{DynamicResource SimpleToggleSwitch}" />
                </StackPanel>
            </Border>

            <!--  左：系统代理 / 路由 下拉（描边胶囊）  -->
            <ComboBox
                x:Name="cmbSystemProxy"
                Classes="StatusCombo"
                Margin="0,0,8,0"
                DockPanel.Dock="Left"
                ToolTip.Tip="{x:Static resx:ResUI.menuSystemproxy}">
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
            </ComboBox>

            <ComboBox
                x:Name="cmbRoutings2"
                Classes="StatusCombo"
                Margin="0,0,12,0"
                DockPanel.Dock="Left"
                DisplayMemberBinding="{Binding Remarks}"
                ItemsSource="{Binding RoutingItems}"
                ToolTip.Tip="{x:Static resx:ResUI.menuRouting}" />


            <!--  左：入站端口信息（单行，· 分隔；空间不够时裁切，不压到右侧节点信息）  -->
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Left"
                ClipToBounds="True"
                Orientation="Horizontal"
                Spacing="4">
                <TextBlock
                    x:Name="txtInboundDisplay"
                    FontSize="11.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding InboundDisplay}" />
                <TextBlock
                    FontSize="11.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    Text="·"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="txtInboundLanDisplay"
                    FontSize="11.5"
                    Foreground="{DynamicResource AppTextSecondary}"
                    TextTrimming="CharacterEllipsis"
                    VerticalAlignment="Center"
                    ToolTip.Tip="{Binding InboundLanDisplay}" />
            </StackPanel>
            <!--  左：实时上下行速率（端口信息之后，空间不足时先裁这里）  -->
            <TextBlock
                x:Name="txtSpeedCompact"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                ToolTip.Tip="实时上行 / 下行速率"
                FontSize="11.5"
                Foreground="{DynamicResource AppTextSecondary}"
                IsVisible="{Binding SpeedCompactDisplay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Text="{Binding SpeedCompactDisplay}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Grid>
</UserControl>
