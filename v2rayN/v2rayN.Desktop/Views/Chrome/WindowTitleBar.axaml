<UserControl
    x:Class="v2rayN.Desktop.Views.Chrome.WindowTitleBar"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Height="34">
    <Border
        Background="{DynamicResource AppSidebarBg}"
        BorderBrush="{DynamicResource AppCardBorder}"
        BorderThickness="0,0,0,1"
        PointerPressed="Root_PointerPressed">
        <DockPanel>
            <Button
                x:Name="btnClose"
                Width="42"
                Height="33"
                Background="Transparent"
                BorderThickness="0"
                Click="BtnClose_Click"
                DockPanel.Dock="Right"
                ToolTip.Tip="关闭">
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource AppTextPrimary}"
                    Text="&#x2715;" />
            </Button>
            <TextBlock
                x:Name="txtTitle"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                FontSize="12.5"
                Foreground="{DynamicResource AppTextPrimary}"
                TextTrimming="CharacterEllipsis" />
        </DockPanel>
    </Border>
</UserControl>
